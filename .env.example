# Copy to .env locally. Never commit .env or paste credentials into a feed.
# Optional: blank means Telegram sending is unavailable. Demo scans never send.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional paths; defaults use this checkout's var/ and data/ directories.
# SCOUT_DB_PATH=var/scout.sqlite3
# SCOUT_FEED_PATH=data/supplier_demo.csv
# SCOUT_AMAZON_CATALOG=data/amazon_demo.json
# Scheduler interval in seconds; watch can override this with --interval.
SCOUT_SCAN_INTERVAL_SECONDS=300
SCOUT_ALERT_COOLDOWN_HOURS=24
